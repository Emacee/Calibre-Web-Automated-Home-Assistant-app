#!/bin/bash
#
# Home Assistant glue, runs before Shelfmark's own entrypoint:
#  - reads the app options from /data/options.json
#  - picks up the ingest folder, library, Hardcover token and user database
#    shared by the Calibre-Web Automated app (read-only via /app_configs)
#  - exports them as Shelfmark environment variables
#  - starts the nginx proxy for Ingress and the Want to Read watcher, then
#    hands over to "$@"

set -e

OPTIONS=/data/options.json
APP_CONFIGS=/app_configs

log()      { echo "[ha-app] $*"; }
fail()     { echo "[ha-app] ERROR: $*" >&2; exit 1; }
opt()      { jq -r "$1 // empty" "$OPTIONS"; }
opt_bool() { jq -r "if $1 == true then \"true\" else \"false\" end" "$OPTIONS"; }

[ -f "$OPTIONS" ] || fail "$OPTIONS not found"

# --- Calibre-Web Automated app ----------------------------------------------
# Its config folder is <repository id>_calibre_web_automated (or
# local_calibre_web_automated for a local copy of the app).
CWA_DIR=""
for dir in "$APP_CONFIGS"/*_calibre_web_automated; do
    [ -d "$dir" ] || continue
    if [ -z "$CWA_DIR" ]; then
        CWA_DIR="$dir"
    else
        log "WARNING: several Calibre-Web Automated apps found, using $CWA_DIR"
    fi
done

CWA_SHARE=""
if [ -z "$CWA_DIR" ]; then
    log "WARNING: Calibre-Web Automated app not found, using this app's options only"
elif [ ! -f "$CWA_DIR/.ha-share/cwa.json" ]; then
    log "WARNING: start or update the Calibre-Web Automated app first to share its settings"
else
    CWA_SHARE="$CWA_DIR/.ha-share"
    log "Calibre-Web Automated app: $CWA_DIR"
fi

cwa_setting() {
    [ -n "$CWA_SHARE" ] || return 0
    jq -r "$1 // empty" "$CWA_SHARE/cwa.json"
}

# --- Ingest folder ----------------------------------------------------------
# Downloads always go to the ingest folder of the CWA app, which imports them
INGEST_PATH="$(cwa_setting '.ingest_path')"
if [ -z "$INGEST_PATH" ]; then
    INGEST_PATH=/share/cwa-book-ingest
    log "WARNING: CWA ingest folder unknown, using the default $INGEST_PATH"
fi
INGEST_PATH="${INGEST_PATH%/}"

# Only /share and /media are mapped into the app and shared with CWA
case "$INGEST_PATH" in
    /share/?*|/media/?*) ;;
    *) fail "CWA ingest folder must be under /share or /media (got '$INGEST_PATH')" ;;
esac
case "$INGEST_PATH" in
    *..*) fail "CWA ingest folder must not contain '..' (got '$INGEST_PATH')" ;;
esac
export INGEST_DIR="$INGEST_PATH"

# --- Delivery into the CWA ingest folder --------------------------------------
# Environment values win over the settings screen (also per-user ones), so
# these keep every download landing where CWA imports it:
#  - books and audiobooks both go to the ingest folder, as files
#  - renamed files, no folders (Shelfmark advises against folders in an
#    ingest folder)
#  - no hardlinks: CWA deletes files after import, archives must be extracted
#  - only formats CWA imports (Shelfmark's defaults without djvu, and the
#    audiobook formats CWA supports); others would sit in the folder forever
export BOOKS_OUTPUT_MODE=folder
export DESTINATION_AUDIOBOOK="$INGEST_PATH"
export FILE_ORGANIZATION=rename
export FILE_ORGANIZATION_AUDIOBOOK=rename
export HARDLINK_TORRENTS=false
export HARDLINK_TORRENTS_AUDIOBOOK=false
export SUPPORTED_FORMATS="epub,mobi,azw3,fb2,cbz,cbr"
export SUPPORTED_AUDIOBOOK_FORMATS="m4b,m4a,mp4"

# --- Library button: opens the CWA app in Home Assistant (new tab) --------
if [ -n "$CWA_DIR" ]; then
    export CALIBRE_WEB_URL="/hassio/ingress/${CWA_DIR##*/}"
fi

# --- Library check: mark books you already own ------------------------------
LIBRARY_PATH="$(cwa_setting '.library_path')"
if [ -n "$LIBRARY_PATH" ] && [ -f "$LIBRARY_PATH/metadata.db" ]; then
    export LIBRARY_CHECK_CALIBRE_ENABLED=true
    export CALIBRE_LIBRARY_DB_PATH="$LIBRARY_PATH/metadata.db"
fi

# --- Hardcover --------------------------------------------------------------
# Looked up on every start: this app's option, the CWA profile token of the
# Ingress user (or first admin), the CWA app option, CWA Basic Configuration
HARDCOVER_SOURCE=""
HARDCOVER_TOKEN=""
{ read -r HARDCOVER_SOURCE; read -r HARDCOVER_TOKEN; } \
    < <(ha-cwa-token "$CWA_DIR" || printf '\n\n')
[ -n "$HARDCOVER_TOKEN" ] || HARDCOVER_SOURCE="not set"
if [ -n "$HARDCOVER_TOKEN" ]; then
    export HARDCOVER_ENABLED=true
    export HARDCOVER_API_KEY="$HARDCOVER_TOKEN"
    export METADATA_PROVIDER=hardcover
fi
unset HARDCOVER_TOKEN

# --- Automatic login through Ingress, as the same user as CWA -----------------
# Shelfmark's proxy login, with a header name that is random for this
# installation (stored in /config, never logged): only nginx on the ingress
# port, which only the Supervisor can reach, sends it. The user is the one
# the CWA app logs in as through Ingress; its admin role carries over.
INGRESS_INCLUDE=/etc/nginx/ha-ingress-login.conf
INGRESS_SECRET=/config/.ha-ingress-login
: > "$INGRESS_INCLUDE"
LOGIN=""
INGRESS_USER="$(cwa_setting '.ingress_user')"
if [ "$(opt_bool '.ingress_auto_login')" = "true" ]; then
    if [ -z "$INGRESS_USER" ]; then
        log "WARNING: CWA shares no Ingress user (its automatic login is off, or CWA has not started yet); restart this app after CWA has started"
    elif [[ "$INGRESS_USER" =~ [\"\\\$\;[:cntrl:]] ]]; then
        log "WARNING: CWA Ingress user name contains characters nginx cannot pass on"
    else
        header="$(cat "$INGRESS_SECRET" 2>/dev/null || true)"
        if ! [[ "$header" =~ ^X-HA-Ingress-[0-9a-f]{32}$ ]]; then
            header="X-HA-Ingress-$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
            (umask 077 && printf '%s' "$header" > "$INGRESS_SECRET")
        fi
        chmod 600 "$INGRESS_SECRET"
        role="user"
        [ "$(cwa_setting '.ingress_user_admin')" = "true" ] && role="admin"
        export AUTH_METHOD=proxy
        export PROXY_AUTH_USER_HEADER="$header"
        export PROXY_AUTH_ADMIN_GROUP_HEADER="$header-Role"
        export PROXY_AUTH_ADMIN_GROUP_NAME=admin
        export PROXY_AUTH_LOGOUT_URL=""
        printf 'proxy_set_header %s "%s";\nproxy_set_header %s-Role "%s";\n' \
            "$header" "$INGRESS_USER" "$header" "$role" > "$INGRESS_INCLUDE"
        LOGIN="automatic as $INGRESS_USER ($role) through Ingress"
        unset header
    fi
fi

# --- Otherwise: log in with the Calibre-Web Automated users ------------------
if [ -z "$LOGIN" ]; then
    LOGIN="Shelfmark settings"
    if [ "$(opt_bool '.use_cwa_login')" = "true" ]; then
        if [ -n "$CWA_DIR" ] && [ -f "$CWA_DIR/app.db" ]; then
            export AUTH_METHOD=cwa
            export CWA_DB_PATH="$CWA_DIR/app.db"
            LOGIN="Calibre-Web Automated users (password)"
        else
            log "WARNING: CWA user database not found, login is set in Shelfmark"
        fi
    fi
fi

# --- API key for the Want to Read watcher ------------------------------------
# Random for this installation, stored in /config and never logged. Only the
# watcher in this app uses it, on localhost.
API_KEY_FILE=/config/.ha-api-key
WANT_TO_READ="off"
WTR_DOWNLOAD="$(opt_bool '.want_to_read_auto_download')"
WTR_MOVE="$(opt_bool '.want_to_read_move_when_imported')"
if [ "$WTR_DOWNLOAD" = "true" ] || [ "$WTR_MOVE" = "true" ]; then
    if [ -z "${HARDCOVER_API_KEY:-}" ]; then
        WANT_TO_READ="off (no Hardcover token)"
    else
        key="$(cat "$API_KEY_FILE" 2>/dev/null || true)"
        if ! [[ "$key" =~ ^[0-9a-f]{64}$ ]]; then
            key="$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')"
            (umask 077 && printf '%s' "$key" > "$API_KEY_FILE")
        fi
        chmod 600 "$API_KEY_FILE"
        export SHELFMARK_API_KEY="$key"
        unset key
        WANT_TO_READ_HOURS="$(opt '.want_to_read_interval_hours')"
        [[ "$WANT_TO_READ_HOURS" =~ ^[0-9]+$ ]] || WANT_TO_READ_HOURS=6
        export HA_WTR_DOWNLOAD="$WTR_DOWNLOAD" HA_WTR_MOVE="$WTR_MOVE"
        WANT_TO_READ=""
        [ "$WTR_DOWNLOAD" = "true" ] && WANT_TO_READ="download every $WANT_TO_READ_HOURS hour(s)"
        [ "$WTR_MOVE" = "true" ] && WANT_TO_READ="${WANT_TO_READ:+$WANT_TO_READ, }imported books to Currently Reading"
    fi
fi

# --- Runtime user -----------------------------------------------------------
# Same uid/gid as CWA's "abc" user, so CWA can process and remove the
# downloaded files in the ingest folder
export PUID=911
export PGID=911

# --- Tor --------------------------------------------------------------------
# Shelfmark's entrypoint starts Tor and redirects all outgoing traffic
# through it (tor.sh) when USING_TOR is set; it needs root and NET_ADMIN,
# both of which this app has. Anything above that talks to the internet
# (the Hardcover token check) has already run without Tor.
TOR="off"
if [ "$(opt_bool '.tor')" = "true" ]; then
    export USING_TOR=true
    TOR="on (starting takes up to a few minutes)"
fi

# --- Extra environment variables (last, so they can override the above) ----
while IFS=$'\t' read -r name value; do
    [ -z "$name" ] && continue
    [[ "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || fail "invalid extra_env name '$name'"
    export "$name=$value"
    log "extra env: $name"
done < <(jq -r '(.extra_env // [])[] | [.name, .value] | @tsv' "$OPTIONS")

log "Ingest folder  : $INGEST_DIR"
log "Library check  : ${CALIBRE_LIBRARY_DB_PATH:-off}"
log "Library button : ${CALIBRE_WEB_URL:-off}"
log "Hardcover token: $HARDCOVER_SOURCE"
log "Login          : $LOGIN"
log "Want to Read   : $WANT_TO_READ"
log "Tor            : $TOR"

# --- Ingress proxy ----------------------------------------------------------
nginx -c /etc/nginx/ha-ingress.conf

# --- Want to Read watcher -----------------------------------------------------
# Shelfmark has no background automation; this checks the Hardcover Want to
# Read list now and then and queues downloads through Shelfmark's API
if [ -n "${WANT_TO_READ_HOURS:-}" ]; then
    ha-want-to-read "$WANT_TO_READ_HOURS" &
fi

exec "$@"
