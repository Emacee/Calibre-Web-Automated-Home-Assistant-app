#!/usr/bin/with-contenv bash
# shellcheck shell=bash
#
# CWA runs `chown -R abc:abc /calibre-library`, which in this app is a
# symlink: chown then changes the link only, leaving the library (including
# a freshly created metadata.db) owned by root and read-only for CWA.
# Repeat it on the real folder once cwa-auto-library is done.

if [ "${NETWORK_SHARE_MODE}" = "true" ]; then
    echo "[ha-addon] NETWORK_SHARE_MODE=true; skipping chown of the library"
    exit 0
fi

# Only what is not abc:abc yet: chown -R rewrites the inode of every book
# and cover on every start, which on a large library on a HDD or network
# share takes minutes. The end result is the same.
LIBRARY="$(readlink -f /calibre-library)"
echo "[ha-addon] Setting ownership of $LIBRARY to abc:abc..."
find "$LIBRARY" \( ! -user abc -o ! -group abc \) -exec chown abc:abc {} +
