#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Finishes the Ingress login setup on the very first start: waits until CWA
# has created app.db, applies the settings and restarts CWA once so they take
# effect. On later starts init-ha-addon has already done it before CWA started.

if [ -f /run/ha-ingress-login-pending ]; then
    for _ in $(seq 1 120); do
        rc=0
        ha-ingress-login || rc=$?
        [ "$rc" -ne 20 ] && break
        sleep 5
    done
    rm -f /run/ha-ingress-login-pending
    nginx -c /etc/nginx/ha-ingress.conf -s reload || true
    if [ "$rc" -eq 10 ]; then
        echo "[ha-addon] Restarting Calibre-Web to enable the Ingress login"
        s6-svc -r /run/service/svc-calibre-web-automated
    fi
fi

exec sleep infinity
